# Copy to .env.local and fill in the values you need.
# The app runs fully without any of these (localStorage only).

# --- Supabase (auth + cloud sync + community chat) ---
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Spotify mini player (optional) ---
# From https://developer.spotify.com/dashboard → your app
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Trading 212 sync (optional) ---
# Generate an API key at https://www.trading212.com/en/Investing/AccountSettings/PersonalAPI
# Set T212_ENV=demo to use your Trading 212 demo account instead of live.
T212_API_KEY=
T212_API_SECRET=
T212_ENV=live
